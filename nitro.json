{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": [
    "munimwifi"
  ],
  "ios": {
    "iosModuleName": "MunimWifi"
  },
  "android": {
    "androidNamespace": [
      "munimwifi"
    ],
    "androidCxxLibName": "MunimWifi"
  },
  "autolinking": {
    "MunimWifi": {
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridMunimWifi"
      },
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridMunimWifi"
      }
    }
  },
  "ignorePaths": [
    "**/node_modules"
  ]
}
