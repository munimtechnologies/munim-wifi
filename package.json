{
  "name": "munim-wifi",
  "version": "0.6.1",
  "description": "Fast Wi-Fi scanning, connection, and network information for Expo and React Native, powered by Nitro Modules",
  "main": "./lib/commonjs/index.js",
  "module": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "react-native": "src/index",
  "source": "src/index",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "clean": "git clean -dfX",
    "release": "semantic-release",
    "release:local": "node scripts/release-local.mjs",
    "build": "npm run typecheck && bob build",
    "codegen": "nitrogen --logLevel=\"debug\" && node scripts/patch-nitro-optionals.js && node scripts/patch-nitrogen-swift.mjs",
    "typecheck:example": "tsc --noEmit -p example/tsconfig.json",
    "prepack": "npm run build",
    "test": "jest",
    "lint": "eslint src example/App.tsx example/selftest.ts example/index.ts app.plugin.js eslint.config.js scripts"
  },
  "keywords": [
    "react-native",
    "munim-wifi",
    "wifi",
    "expo",
    "ios",
    "android",
    "typescript",
    "nitro",
    "nitro-modules",
    "network-scanning",
    "munim-technologies"
  ],
  "files": [
    "src",
    "react-native.config.js",
    "lib",
    "nitrogen",
    "cpp",
    "nitro.json",
    "android/build.gradle",
    "android/fix-prefab.gradle",
    "android/gradle.properties",
    "android/CMakeLists.txt",
    "android/src",
    "ios/**/*.h",
    "ios/**/*.m",
    "ios/**/*.mm",
    "ios/**/*.cpp",
    "ios/**/*.swift",
    "app.plugin.js",
    "*.podspec",
    "README.md",
    "CONTRIBUTING.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "workspaces": [
    "example"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/munimtechnologies/munim-wifi.git"
  },
  "author": "sheehanmunim <support@munimtech.com> (https://github.com/sheehanmunim)",
  "license": "Apache-2.0",
  "bugs": "https://github.com/munimtechnologies/munim-wifi/issues",
  "homepage": "https://github.com/munimtechnologies/munim-wifi#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "expo": {
    "name": "munim-wifi",
    "platforms": [
      "ios",
      "android"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@expo/config-plugins": "58.0.13",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@types/jest": "^30.0.0",
    "@types/react": "19.3.0",
    "conventional-changelog-conventionalcommits": "^10.4.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "nitrogen": "0.37.2",
    "prettier": "^3.10.1",
    "react": "19.3.1",
    "react-native": "0.88.1",
    "react-native-builder-bob": "^0.44.1",
    "react-native-nitro-modules": "0.37.2",
    "semantic-release": "^26.0.1",
    "ts-jest": "^29.4.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2"
  },
  "peerDependencies": {
    "@expo/config-plugins": ">=10 <59",
    "react": "*",
    "react-native": "*",
    "react-native-nitro-modules": ">=0.36.5 <1"
  },
  "peerDependenciesMeta": {
    "@expo/config-plugins": {
      "optional": true
    }
  },
  "overrides": {
    "brace-expansion@1.x": "1.1.21",
    "brace-expansion@2.x": "2.1.7",
    "brace-expansion@>=3 <6": "5.0.12",
    "js-yaml@3.x": "3.15.2",
    "js-yaml@4.x": "4.3.2",
    "minimatch@3.x": "3.1.5",
    "picomatch@2.x": "2.3.2",
    "uuid": "11.1.1",
    "@semantic-release/npm": {
      "npm": "npm:@semantic-release/error@4.0.0"
    },
    "undici@6.x": "6.29.0",
    "undici@7.x": "7.30.0"
  },
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false,
    "semi": false
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.json"
        }
      ]
    ]
  }
}
