{
  "expo": {
    "name": "Munim Wi-Fi Example",
    "slug": "munim-wifi-example",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sheehanmunim.munimwifiexample"
    },
    "android": {
      "package": "com.sheehanmunim.munimwifiexample"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ],
      [
        "munim-wifi",
        {
          "locationPermission": "Allow Munim Wi-Fi Example to find nearby Wi-Fi networks.",
          "localNetworkPermission": "Allow Munim Wi-Fi Example to discover services on your local network.",
          "bonjourServices": [
            "_http._tcp",
            "_ipp._tcp",
            "_airplay._tcp",
            "_googlecast._tcp",
            "_raop._tcp",
            "_companion-link._tcp"
          ]
        }
      ]
    ]
  }
}
